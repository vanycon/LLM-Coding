@startuml
!include <C4/C4_Container>

ContainerDb(db, "SQLite-Datei", "Katalog, Ausleihen, Kaution, Audit-Log")
Person(mitglied, "Mitglied", "Sabine — prüft Verfügbarkeit, merkt vor")
Person(theke, "Thekendienst", "Karim — gibt aus, verlängert, nimmt zurück")
Person(wart, "Werkstattwart", "Rolf — prüft, wartet, mustert aus, entscheidet über Kaution")
System_Boundary(leihgut, "Leihgut") {
  Container(leihgut_cli, "CLI-Adapter", "Typer + httpx", "Ruft REST-Adapter lokal per HTTP auf; keine eigene Fachlogik")
  Container(leihgut_kern, "Anwendungskern", "reines Python", "Anwendungsdienste + Domänenmodell; alle BR-IDs")
  Container(leihgut_persistenz, "Persistenz-Adapter", "sqlite3", "Implementiert Repository-Ports; Audit-Log")
  Container(leihgut_rest, "REST-Adapter", "FastAPI", "Validiert Eingaben, mappt DTO <-> Anwendungsdienst, setzt Statuscodes (SI-01..SI-11)")
  Container(leihgut_zeit, "Zeitquelle-Adapter", "Python", "Implementiert Clock-Port: Systemuhr (Produktion) / Fake (Test)")
}

Rel(theke, leihgut, "gibt aus / verlängert / nimmt zurück")
Rel(mitglied, leihgut, "prüft Verfügbarkeit / merkt vor")
Rel(wart, leihgut, "schließt Prüfung/Wartung ab, meldet Verlust, pflegt Katalog/Einweisung")
Rel(theke, leihgut_rest, "HTTP/JSON")
Rel(mitglied, leihgut_rest, "HTTP/JSON")
Rel(wart, leihgut_cli, "Terminal")
Rel(wart, leihgut_rest, "HTTP/JSON (alternativ)")
Rel(leihgut_cli, leihgut_rest, "HTTP/JSON, localhost")
Rel(leihgut_rest, leihgut_kern, "ruft auf, DTO")
Rel(leihgut_kern, leihgut_persistenz, "Repository-Port")
Rel(leihgut_kern, leihgut_zeit, "Clock-Port")
Rel(leihgut_persistenz, db, "SQL")
@enduml
