@startuml
!include <C4/C4_Component>

Container_Boundary(leihgut_kern, "Anwendungskern") {
  Component(leihgut_kern_ausgabe, "Ausleihe-Anwendungsdienst", "UC-01, UC-02, UC-03, UC-06")
  Component(leihgut_kern_ausleihe_agg, "Ausleihe-Aggregat", "Zustandsautomat Ausleihe, Verlängerung, Überfälligkeit")
  Component(leihgut_kern_einweisung, "Einweisungs-Anwendungsdienst", "UC-07, UC-08")
  Component(leihgut_kern_gegenstand, "Gegenstand-Aggregat", "Zustandsautomat Gegenstand, Nutzungszähler, Mängelliste")
  Component(leihgut_kern_katalog, "Katalog-Anwendungsdienst", "UC-09")
  Component(leihgut_kern_kaution, "Kaution-Domänendienst", "Berechnung BR-KAT-04, Bewegungen BR-KAU")
  Component(leihgut_kern_mitglied_agg, "Mitglied-Aggregat", "Sperre als abgeleitetes Prädikat (BR-SPE)")
