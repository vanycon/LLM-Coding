Rel(leihgut_kern_pruefung, leihgut_kern_kaution, "Abzug, Freigabe")
Rel(leihgut_kern_pruefung, leihgut_kern_warteschlange, "Reservierung vergeben")
Rel(leihgut_kern_vormerkung, leihgut_kern_warteschlange, "einreihen, Verfall")
Rel(leihgut_kern_katalog, leihgut_kern_gegenstand, "anlegen/ändern")
Rel(leihgut_kern_einweisung, leihgut_kern_mitglied_agg, "Einweisung erfassen/widerrufen")
Rel(leihgut_kern_ausgabe, leihgut_kern_ports, "nutzt")
Rel(leihgut_kern_pruefung, leihgut_kern_ports, "nutzt")
