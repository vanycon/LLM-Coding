{
  "$schema": "https://raw.githubusercontent.com/docToolchain/Bausteinsicht/main/schemas/bausteinsicht.schema.json",

  // Specification: element kinds and relationship types for the "Leihgut" architecture.
  // Mirrors the C4 levels used in arc42 chapters 3 (Kontextabgrenzung) and 5 (Bausteinsicht):
  // actor -> system (fachlicher Kontext) -> container (technischer Kontext / Ebene 1)
  // -> component (Ebene 2, Anwendungskern).
  "specification": {
    "elements": {
      "actor": {
        "notation": "Actor",
        "description": "Person/Rolle nach spec.adoc: Thekendienst, Mitglied, Werkstattwart"
      },
      "system": {
        "notation": "Software System",
        "description": "Das Leihgut-System als Ganzes",
        "container": true
      },
      "container": {
        "notation": "Container",
        "description": "Deployierbare Einheit oder Prozessbestandteil",
        "container": true
      },
      "datastore": {
        "notation": "Data Store",
        "description": "Persistenter Datenspeicher"
      },
      "component": {
        "notation": "Component",
        "description": "Logisches Modul innerhalb eines Containers (Anwendungskern)"
      }
    },
    "relationships": {
      "uses": {
        "notation": "nutzt"
      }
    }
  },

  // Model: die Bausteine von Ebene 0 (Kontext) bis Ebene 2 (Anwendungskern-Komponenten).
  "model": {
    "theke": {
      "kind": "actor",
      "title": "Thekendienst",
      "description": "Karim — gibt aus, verlängert, nimmt zurück"
    },
    "mitglied": {
      "kind": "actor",
      "title": "Mitglied",
      "description": "Sabine — prüft Verfügbarkeit, merkt vor"
    },
    "wart": {
      "kind": "actor",
      "title": "Werkstattwart",
      "description": "Rolf — prüft, wartet, mustert aus, entscheidet über Kaution"
    },
    "leihgut": {
      "kind": "system",
      "title": "Leihgut",
      "description": "Verwaltet Katalog, Ausleihen, Kaution, Wartung, Vormerkung",
      "children": {
        "rest": {
          "kind": "container",
          "title": "REST-Adapter",
          "technology": "FastAPI",
          "description": "Validiert Eingaben, mappt DTO <-> Anwendungsdienst, setzt Statuscodes (SI-01..SI-11)"
        },
        "cli": {
          "kind": "container",
          "title": "CLI-Adapter",
          "technology": "Typer + httpx",
          "description": "Ruft REST-Adapter lokal per HTTP auf; keine eigene Fachlogik"
        },
        "kern": {
          "kind": "container",
          "title": "Anwendungskern",
          "technology": "reines Python",
          "description": "Anwendungsdienste + Domänenmodell; alle BR-IDs",
          "children": {
            "ausgabe": {
              "kind": "component",
              "title": "Ausleihe-Anwendungsdienst",
              "description": "UC-01, UC-02, UC-03, UC-06"
            },
            "pruefung": {
              "kind": "component",
              "title": "Prüfung/Wartungs-Anwendungsdienst",
              "description": "UC-04, UC-05"
            },
            "katalog": {
              "kind": "component",
              "title": "Katalog-Anwendungsdienst",
              "description": "UC-09"
            },
            "einweisung": {
              "kind": "component",
              "title": "Einweisungs-Anwendungsdienst",
              "description": "UC-07, UC-08"
            },
            "vormerkung": {
              "kind": "component",
              "title": "Vormerkungs-Anwendungsdienst",
              "description": "UC-10, UC-11"
            },
            "gegenstand": {
              "kind": "component",
              "title": "Gegenstand-Aggregat",
              "description": "Zustandsautomat Gegenstand, Nutzungszähler, Mängelliste"
            },
            "ausleihe_agg": {
              "kind": "component",
              "title": "Ausleihe-Aggregat",
              "description": "Zustandsautomat Ausleihe, Verlängerung, Überfälligkeit"
            },
            "mitglied_agg": {
              "kind": "component",
              "title": "Mitglied-Aggregat",
              "description": "Sperre als abgeleitetes Prädikat (BR-SPE)"
            },
            "kaution": {
              "kind": "component",
              "title": "Kaution-Domänendienst",
              "description": "Berechnung BR-KAT-04, Bewegungen BR-KAU"
            },
            "warteschlange": {
              "kind": "component",
              "title": "Warteschlange-Aggregat",
              "description": "Vormerkung/Reservierung, FIFO, Verfall"
            },
            "ports": {
              "kind": "component",
              "title": "Ports",
              "description": "Repository- und Clock-Schnittstellen (Interfaces)"
            }
          }
        },
        "persistenz": {
          "kind": "container",
          "title": "Persistenz-Adapter",
          "technology": "sqlite3",
          "description": "Implementiert Repository-Ports; Audit-Log"
        },
        "zeit": {
          "kind": "container",
          "title": "Zeitquelle-Adapter",
          "technology": "Python",
          "description": "Implementiert Clock-Port: Systemuhr (Produktion) / Fake (Test)"
        }
      }
    },
    "db": {
      "kind": "datastore",
      "title": "SQLite-Datei",
      "description": "Katalog, Ausleihen, Kaution, Audit-Log"
    }
  },

  "relationships": [
    // Fachlicher Kontext (system-level)
    { "from": "theke",    "to": "leihgut", "type": "uses", "label": "gibt aus / verlängert / nimmt zurück" },
    { "from": "mitglied", "to": "leihgut", "type": "uses", "label": "prüft Verfügbarkeit / merkt vor" },
    { "from": "wart",     "to": "leihgut", "type": "uses", "label": "schließt Prüfung/Wartung ab, meldet Verlust, pflegt Katalog/Einweisung" },

    // Technischer Kontext / Ebene 1 (container-level)
    { "from": "theke",             "to": "leihgut.rest", "type": "uses", "label": "HTTP/JSON" },
    { "from": "mitglied",          "to": "leihgut.rest", "type": "uses", "label": "HTTP/JSON" },
    { "from": "wart",              "to": "leihgut.cli",  "type": "uses", "label": "Terminal" },
    { "from": "wart",              "to": "leihgut.rest", "type": "uses", "label": "HTTP/JSON (alternativ)" },
    { "from": "leihgut.cli",       "to": "leihgut.rest", "type": "uses", "label": "HTTP/JSON, localhost" },
    { "from": "leihgut.rest",      "to": "leihgut.kern", "type": "uses", "label": "ruft auf, DTO" },
    { "from": "leihgut.kern",      "to": "leihgut.persistenz", "type": "uses", "label": "Repository-Port" },
    { "from": "leihgut.kern",      "to": "leihgut.zeit", "type": "uses", "label": "Clock-Port" },
    { "from": "leihgut.persistenz", "to": "db", "type": "uses", "label": "SQL" },

    // Ebene 2: Anwendungskern (component-level)
    { "from": "leihgut.kern.ausgabe",    "to": "leihgut.kern.gegenstand",     "type": "uses", "label": "prüft/ändert Zustand" },
    { "from": "leihgut.kern.ausgabe",    "to": "leihgut.kern.ausleihe_agg",   "type": "uses", "label": "legt an / schließt ab" },
    { "from": "leihgut.kern.ausgabe",    "to": "leihgut.kern.mitglied_agg",   "type": "uses", "label": "prüft Sperre, Limit" },
    { "from": "leihgut.kern.ausgabe",    "to": "leihgut.kern.kaution",        "type": "uses", "label": "hinterlegt/verlängert" },
    { "from": "leihgut.kern.pruefung",   "to": "leihgut.kern.ausleihe_agg",   "type": "uses", "label": "schließt ab (Prüfprotokoll/Verlust)" },
    { "from": "leihgut.kern.pruefung",   "to": "leihgut.kern.gegenstand",     "type": "uses", "label": "Nutzungszähler, Folgezustand" },
    { "from": "leihgut.kern.pruefung",   "to": "leihgut.kern.kaution",        "type": "uses", "label": "Abzug, Freigabe" },
    { "from": "leihgut.kern.pruefung",   "to": "leihgut.kern.warteschlange",  "type": "uses", "label": "Reservierung vergeben" },
    { "from": "leihgut.kern.vormerkung", "to": "leihgut.kern.warteschlange",  "type": "uses", "label": "einreihen, Verfall" },
    { "from": "leihgut.kern.katalog",    "to": "leihgut.kern.gegenstand",     "type": "uses", "label": "anlegen/ändern" },
    { "from": "leihgut.kern.einweisung", "to": "leihgut.kern.mitglied_agg",   "type": "uses", "label": "Einweisung erfassen/widerrufen" },
    { "from": "leihgut.kern.ausgabe",    "to": "leihgut.kern.ports", "type": "uses", "label": "nutzt" },
    { "from": "leihgut.kern.pruefung",   "to": "leihgut.kern.ports", "type": "uses", "label": "nutzt" },
    { "from": "leihgut.kern.katalog",    "to": "leihgut.kern.ports", "type": "uses", "label": "nutzt" },
    { "from": "leihgut.kern.einweisung", "to": "leihgut.kern.ports", "type": "uses", "label": "nutzt" },
    { "from": "leihgut.kern.vormerkung", "to": "leihgut.kern.ports", "type": "uses", "label": "nutzt" }
  ],

  // Views: Ebene 0 (fachlich), Ebene 1 (technisch/Container), Ebene 2 (Anwendungskern-Komponenten).
  "views": {
    "context-business": {
      "title": "Fachlicher Kontext Leihgut",
      "include": ["theke", "mitglied", "wart", "leihgut"],
      "description": "arc42 Kapitel 3, fachlicher Kontext"
    },
    "context-technical": {
      "title": "Technischer Kontext Leihgut",
      "scope": "leihgut",
      "include": ["theke", "mitglied", "wart", "leihgut.rest", "leihgut.cli", "leihgut.kern", "db"],
      "description": "arc42 Kapitel 3, technischer Kontext"
    },
    "bb-level1": {
      "title": "Bausteinsicht Ebene 1 — Leihgut-Prozess",
      "scope": "leihgut",
      "include": ["theke", "mitglied", "wart", "leihgut.*", "db"],
      "description": "arc42 Kapitel 5, Whitebox Gesamtsystem"
    },
    "bb-level2": {
      "title": "Bausteinsicht Ebene 2 — Anwendungskern",
      "scope": "leihgut.kern",
      "include": ["leihgut.kern.*"],
      "description": "arc42 Kapitel 5, Whitebox Anwendungskern"
    }
  }
}
